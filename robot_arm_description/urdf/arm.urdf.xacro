<?xml version="1.0"?>
<robot name="5dof_robotic_arm">

  <!-- A fixed frame to act as the root of the TF tree -->
  <link name="world"/>

  <!-- A fixed joint to attach the robot's base to the world frame -->
  <joint name="fixed_world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base.stl"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="joint1_link"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="joint1_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint1.stl"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="joint1_link"/>
    <child link="joint2_link"/>
    <axis xyz="1 0 0"/> 
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="joint2_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint2.stl"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="joint2_link"/>
    <child link="joint3_link"/>
    <axis xyz="1 0 0"/> 
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>

  <link name="joint3_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint3.stl"/>
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/joint3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="end_effector_joint" type="revolute">
    <parent link="joint3_link"/>
    <child link="end_effector"/>
    <axis xyz="1 0 0"/> 
    <limit lower="-3.14" upper="3.14" effort="5" velocity="0.5"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="end_effector">
    <visual>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/end_effector.stl"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_arm_description/meshes/end_effector.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

</robot>
