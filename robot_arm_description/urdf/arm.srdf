<?xml version="1.0"?>
<robot name="arm5dof">

  <!-- Planning Groups -->
  <group name="arm_group">
    <chain base_link="base_link" tip_link="end_effector"/>
    <joint name="joint1"/>
    <joint name="joint2"/>
    <joint name="joint3"/>
    <joint name="joint4"/>
  </group>

  <!-- Disable Collisions -->
  <disable_collisions link1="base_link" link2="link1"/>
  <disable_collisions link1="link1" link2="link2"/>
  <!-- Add more as needed -->
</robot>